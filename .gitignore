# dependencies
node_modules/

# Expo
.expo/
dist/
# The buildless website's dist directory contains reviewed source.
!website/dist/
!website/dist/**
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example

# Private signing setup; the standard tracked debug key is intentionally public.
signing.properties
*.keystore
!android/app/debug.keystore
*.wav
*.m4a
*.mp3
*.aac
*.pcm

# typescript
*.tsbuildinfo

# Local build and device verification artifacts
artifacts/

# Local Python verification caches
__pycache__/
*.pyc
